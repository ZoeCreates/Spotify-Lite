# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/spotify-lite

# For production, use MongoDB Atlas or similar
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/spotify-lite

# Authentication
# Generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# For production, update with your frontend URL
# CORS_ORIGIN=https://your-frontend-domain.com 